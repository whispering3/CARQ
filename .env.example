# ─────────────────────────────────────────────────────────────────────────
# Configuração do CARQ - Copie para .env e personalize para seu ambiente
# ─────────────────────────────────────────────────────────────────────────

# Ambiente
CARQ_ENVIRONMENT=development
CARQ_DEBUG=true

# ─────────────────────────────────────────────────────────────────────────
# Banco de dados (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────────────────────────────
CARQ_DB_HOST=localhost
CARQ_DB_PORT=5432
CARQ_DB_USER=postgres
CARQ_DB_PASSWORD=postgres
CARQ_DB_DATABASE=carq
CARQ_DB_POOL_SIZE=20
CARQ_DB_MAX_OVERFLOW=10
CARQ_DB_POOL_TIMEOUT=30
CARQ_DB_ECHO=false

# ─────────────────────────────────────────────────────────────────────────
# Redis (Opcional - para cache de embeddings)
# ─────────────────────────────────────────────────────────────────────────
CARQ_REDIS_ENABLED=false
CARQ_REDIS_HOST=localhost
CARQ_REDIS_PORT=6379
CARQ_REDIS_PASSWORD=
CARQ_REDIS_TTL=3600

# ─────────────────────────────────────────────────────────────────────────
# Limitação de Taxa
# ─────────────────────────────────────────────────────────────────────────
CARQ_RATELIMIT_OPENAI_RPM=3000
CARQ_RATELIMIT_OPENAI_TPM=1500000
CARQ_RATELIMIT_LOCAL_EMBEDDING_WORKERS=4
CARQ_RATELIMIT_REFILL_RATE=100.0
CARQ_RATELIMIT_BURST_CAPACITY=1000.0
CARQ_RATELIMIT_INITIAL_BACKOFF=1.0
CARQ_RATELIMIT_MAX_BACKOFF=300.0
CARQ_RATELIMIT_EXPONENTIAL_BASE=2.0

# ─────────────────────────────────────────────────────────────────────────
# Circuit Breaker
# ─────────────────────────────────────────────────────────────────────────
CARQ_CIRCUIT_FAILURE_THRESHOLD=5
CARQ_CIRCUIT_RECOVERY_TIMEOUT=60
CARQ_CIRCUIT_SUCCESS_THRESHOLD=2

# ─────────────────────────────────────────────────────────────────────────
# Workers
# ─────────────────────────────────────────────────────────────────────────
CARQ_WORKER_PDF_PARSER_WORKERS=4
CARQ_WORKER_CHUNK_WORKERS=8
CARQ_WORKER_EMBEDDING_WORKERS=2
CARQ_WORKER_VECTOR_INSERT_WORKERS=4
CARQ_WORKER_BATCH_SIZE=100
CARQ_WORKER_TASK_TIMEOUT=300
CARQ_WORKER_RETRY_MAX_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────
# Embeddings
# ─────────────────────────────────────────────────────────────────────────
CARQ_EMBEDDING_PROVIDER=openai
CARQ_EMBEDDING_OPENAI_API_KEY=sk-...
CARQ_EMBEDDING_OPENAI_MODEL=text-embedding-3-large
CARQ_EMBEDDING_LOCAL_MODEL=all-MiniLM-L6-v2
CARQ_EMBEDDING_LOCAL_DEVICE=cpu
CARQ_EMBEDDING_DIMENSION=3072
CARQ_EMBEDDING_CACHE_EMBEDDINGS=true

# ─────────────────────────────────────────────────────────────────────────
# Servidor de API
# ─────────────────────────────────────────────────────────────────────────
CARQ_API_HOST=0.0.0.0
CARQ_API_PORT=8000
CARQ_API_WORKERS=4
CARQ_API_DEBUG=false
CARQ_API_RELOAD=false
CARQ_API_JWT_SECRET=your-super-secret-key-change-in-production
CARQ_API_JWT_ALGORITHM=HS256
# OBRIGATÓRIO: Lista separada por vírgulas de chaves de API válidas (use valores aleatórios fortes em produção)
# Gere com: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
CARQ_API_KEYS=sk-your-key-1,sk-your-key-2

# ─────────────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────────────
CARQ_LOG_LEVEL=INFO
CARQ_LOG_FORMAT=json
CARQ_LOG_FILE=

# ─────────────────────────────────────────────────────────────────────────
# Rastreamento Distribuído (Opcional)
# ─────────────────────────────────────────────────────────────────────────
CARQ_ENABLE_TRACING=false
CARQ_JAEGER_HOST=localhost
CARQ_JAEGER_PORT=6831
